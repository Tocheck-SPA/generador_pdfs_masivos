# ============================================================
# ToCheck Reportes — variables de entorno (ejemplo)
# Copia este archivo a .env y completa los valores.
# Para desarrollo local con fixtures NO necesitas credenciales reales.
# ============================================================

# ---------- Web (Next.js / Vercel) ----------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-secret-change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_ALLOWED_EMAILS=jeanpierre@tocheck.cl
AUTH_ALLOWED_DOMAINS=tocheck.cl
# En desarrollo, si no hay Google configurado se usa el proveedor "dev-credentials".
AUTH_DEV_MODE=true

# Base operativa (Neon). En dev con fixtures puede quedar vacío.
DATABASE_URL=

# Cloud Run Job (producción; desactivado en local)
CLOUD_RUN_DISPATCH_ENABLED=false
WORKER_DISPATCH_PROVIDER=disabled
GCP_PROJECT_ID=
CLOUD_RUN_REGION=
CLOUD_RUN_JOB_NAME=tocheck-reportes
GCP_WORKLOAD_IDENTITY_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL=vercel
GCP_WORKLOAD_IDENTITY_PROVIDER=vercel
GCP_SERVICE_ACCOUNT_EMAIL=
AWS_REGION=
AWS_ROLE_ARN=
AWS_LAMBDA_FUNCTION_NAME=
AWS_LAMBDA_QUALIFIER=

# ---------- Source database (ToCheck, solo lectura) ----------
# La base fuente de ToCheck es AWS RDS MySQL -> usa SOURCE_ADAPTER=mysql y los RDS_*.
# fixture | mysql | postgres | snapshot
SOURCE_ADAPTER=fixture
SOURCE_DATABASE_STATEMENT_TIMEOUT_SECONDS=60
SOURCE_QUERY_BATCH_SIZE=100

# --- Fuente MySQL (AWS RDS) — misma convención que tus otros proyectos ToCheck ---
RDS_HOST=
RDS_PORT=3306
RDS_USER=readonly_user
RDS_PASS=
RDS_DB=tocheck_prod
SOURCE_COMPANY_ID=254
# RDS acepta conexión sin SSL en tu setup actual; ponlo en true para exigir TLS.
SOURCE_DATABASE_USE_SSL=false
# Base pública/CDN de las imágenes de la fuente (para resolver rutas relativas).
SOURCE_ASSET_BASE_URL=https://tocheck.s3.amazonaws.com
# Base pública de los logos de empresa (separada de las fotos de respuestas).
SOURCE_LOGO_BASE_URL=https://app.tocheck.cl/public/upload/files/logo_empresa
# Logo oficial de ToCheck, usado siempre en portada, firmas y pie de página.
TOCHECK_LOGO_URL=https://app.tocheck.cl/public/img_tocheck/logo_negro.png

# En producción web/worker usan SOURCE_ADAPTER=snapshot y leen el snapshot
# diario de Neon. El comando `python -m app.main ingest` usa RDS_* para cargarlo.

# --- Fuente PostgreSQL (solo si algún día la fuente fuera Postgres) ---
SOURCE_DATABASE_URL=
SOURCE_DATABASE_SSLMODE=require

# ---------- Worker ----------
WORKER_ID=worker-local-1
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_HEARTBEAT_SECONDS=15
WORKER_STALE_AFTER_SECONDS=300
WORKER_MAX_ATTEMPTS=3

# ---------- R2 (Cloudflare) ----------
# storage backend: local | r2 | s3
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto
AWS_S3_BUCKET=
AWS_S3_REGION=us-east-1
AWS_S3_PREFIX=reports
AWS_S3_ENDPOINT=
AWS_S3_ROLE_ARN=
REPORT_LINK_EXPIRATION_DAYS=15
REPORT_RETENTION_DAYS=90

# ---------- Email ----------
# email backend: console | resend | ses
EMAIL_BACKEND=console
RESEND_API_KEY=
# Si EMAIL_BACKEND=ses, usa el rol de Lambda / credenciales AWS. Opcional:
SES_REGION=
EMAIL_FROM=reportes@tocheck.cl
EMAIL_REPLY_TO=jeanpierre@tocheck.cl
MAX_EMAIL_ATTACHMENT_BYTES=25000000

# ---------- Límites ----------
MAX_RESPONSES_PER_JOB=1000
MAX_RECIPIENTS_PER_JOB=20
MAX_DATE_RANGE_DAYS=366

# ---------- PDF ----------
PDF_TEMPLATE_VERSION=1
PDF_GENERATOR_VERSION=1
PDF_IMAGE_MAX_DIMENSION=1600
PDF_JPEG_QUALITY=80
PDF_RENDER_TIMEOUT_SECONDS=60
PDF_MAX_CONCURRENCY=2
